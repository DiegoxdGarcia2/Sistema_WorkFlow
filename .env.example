# ═══════════════════════════════════════════════════════
# Variables de Entorno — BPM Inteligente
# ═══════════════════════════════════════════════════════
# Copia este archivo a .env y reemplaza con tus valores reales.
# NUNCA subas el archivo .env al repositorio.
# ═══════════════════════════════════════════════════════

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/bpm_inteligente

# Groq Cloud API Key (usado por el microservicio Python)
GROQ_API_KEY=gsk_your_key_here

# URL del microservicio de IA (Python/FastAPI)
AI_MICROSERVICE_URL=http://localhost:8000

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=tu_aws_access_key_id
AWS_SECRET_ACCESS_KEY=tu_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=bucket-bpm

