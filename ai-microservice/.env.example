# ═══════════════════════════════════════════════════════
# Variables de Entorno — AI Microservice (Python/FastAPI)
# ═══════════════════════════════════════════════════════
# Copia este archivo a .env y reemplaza con tus valores reales.
# NUNCA subas el archivo .env al repositorio.
# ═══════════════════════════════════════════════════════

# Groq Cloud API Key (LLM)
GROQ_API_KEY=gsk_your_key_here

# ElevenLabs API Key (Text-to-Speech) — Fase 2
ELEVENLABS_API_KEY=your_key_here

# Puerto del servidor (default: 8000)
AI_SERVICE_PORT=8000

# MongoDB Atlas (mismo cluster que Spring Boot — Fase 3 ML)
# Copia el mismo MONGO_URI de tu .env del backend-core
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/bpm_inteligente?retryWrites=true&w=majority
MONGO_DB_NAME=bpm_inteligente
