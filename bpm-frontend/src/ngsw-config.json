{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/public/**",
          "/*.(svg|png|jpg|jpeg|gif|webp|woff|woff2|ttf|otf)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "catalogos-api",
      "urls": [
        "**/api/politicas/**",
        "**/api/departamentos/**",
        "**/api/cargos/**"
      ],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "1d",
        "timeout": "5s",
        "strategy": "performance"
      }
    },
    {
      "name": "tramites-api",
      "urls": [
        "**/api/tramites/**",
        "**/api/registros/**"
      ],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "12h",
        "timeout": "10s",
        "strategy": "freshness"
      }
    }
  ]
}
